{
  "name": "@supersuit/streak-steward",
  "version": "0.1.0",
  "description": "Count streaks the same way in every app, and say on the home screen which ones end today and what saves them.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/check-dist.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:private-words": "node scripts/private-words.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check:private-words && npm run check:comment-dates && npm run check:consumer",
    "check:comment-dates": "node scripts/check-comment-dates.mjs",
    "check:consumer": "node scripts/check-consumer.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SupersuitUp/streak-steward.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "supersuit",
    "streak",
    "habits",
    "reminder",
    "react"
  ],
  "dependencies": {
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^27.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
